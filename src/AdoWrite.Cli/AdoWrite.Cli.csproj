<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AdoWrite.Cli</AssemblyName>
    <RootNamespace>AdoWrite</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <PackRelease>true</PackRelease>
    <ToolCommandName>ado-write</ToolCommandName>
    <PackageId>ado-write</PackageId>
    <Description>Post Azure DevOps pull-request and work-item comments, requeue pull-request builds and vote on your behalf, for AI agents.</Description>
    <PackageTags>$(PackageTags);pull-requests;work-items;comments;code-review;requeue-build;vote</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdoWrite.Core\AdoWrite.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
