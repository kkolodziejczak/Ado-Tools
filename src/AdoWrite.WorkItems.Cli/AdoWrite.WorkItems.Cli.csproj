<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AdoWrite.WorkItems.Cli</AssemblyName>
    <RootNamespace>AdoWrite</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <PackRelease>true</PackRelease>
    <ToolCommandName>ado-write-work-item</ToolCommandName>
    <PackageId>ado-write-work-item</PackageId>
    <Description>Post Azure DevOps work-item discussion comments on your behalf, for AI agents.</Description>
    <PackageTags>$(PackageTags);work-items;comments;boards</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdoWrite.Core\AdoWrite.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
