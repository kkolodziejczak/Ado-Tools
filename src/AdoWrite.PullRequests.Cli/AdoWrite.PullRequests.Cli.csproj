<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AdoWrite.PullRequests.Cli</AssemblyName>
    <RootNamespace>AdoWrite</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <PackRelease>true</PackRelease>
    <ToolCommandName>ado-write-pr</ToolCommandName>
    <PackageId>AdoWrite.PullRequests.Tool</PackageId>
    <Version>1.0.0</Version>
    <Description>Post Azure DevOps pull-request comments, line comments and replies on your behalf, for AI agents.</Description>
    <PackageTags>azure-devops;comments;cli;json</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdoWrite.Core\AdoWrite.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
